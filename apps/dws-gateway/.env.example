DWS_GATEWAY_HOST=127.0.0.1
DWS_GATEWAY_PORT=8787
DWS_GATEWAY_TOKEN=replace-with-a-long-random-token
# Run `which dws` on B and use the absolute path for launchd.
# DWS_BIN=/opt/homebrew/bin/dws
DWS_ALLOWED_GROUPS=
DWS_MAX_ITEMS=5000
DWS_MAX_CONCURRENT=2
DWS_REQUEST_TIMEOUT_SECONDS=120
DWS_LOG_REQUESTS=1
