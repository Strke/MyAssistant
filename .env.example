NODE_ENV=development
LOG_LEVEL=info

MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-4-6
MODEL_API_KEY=
MODEL_THINKING_LEVEL=off

AGENT_WORKSPACE=.
AGENT_SYSTEM_PROMPT_FILE=

DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=

RAG_ENABLED=true
RAG_DB_PATH=./data/assistant.db
RAG_TOP_K=8
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=3072
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_PROVIDER=hash   # local deterministic embedder, dev/test only

VAULT_PATH=./data/vault.enc
VAULT_KEYCHAIN_SERVICE=com.myassistant.vault
VAULT_KEYCHAIN_ACCOUNT=default
VAULT_AUTO_LOCK_MINUTES=15

TASKS_ENABLED=true
TASKS_BACKEND=local
