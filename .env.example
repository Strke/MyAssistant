NODE_ENV=development
LOG_LEVEL=info

MODEL_PROVIDER=anthropic
MODEL_ID=claude-sonnet-4-6
MODEL_API_KEY=
MODEL_THINKING_LEVEL=off

AGENT_WORKSPACE=.
AGENT_SYSTEM_PROMPT_FILE=

DINGTALK_ENABLED=false
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
# Optional for passive sessionWebhook replies; used by future proactive sends.
DINGTALK_ROBOT_CODE=
DINGTALK_RATE_LIMIT_PER_MINUTE=20
DINGTALK_MAX_MESSAGE_CHARS=8000
DINGTALK_SESSION_IDLE_MINUTES=120
DINGTALK_MAX_SESSIONS=100

RAG_ENABLED=true
RAG_DB_PATH=./data/assistant.db
RAG_TOP_K=8
RAG_EMBEDDING_PROVIDER=openai
RAG_EMBEDDING_MODEL=text-embedding-3-large
RAG_EMBEDDING_DIMENSIONS=3072
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_BASE_URL=https://api.openai.com/v1
# RAG_EMBEDDING_PROVIDER=hash   # local deterministic embedder, dev/test only
# Local Ollama bge-m3 example:
# RAG_EMBEDDING_MODEL=bge-m3
# RAG_EMBEDDING_DIMENSIONS=1024
# RAG_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# RAG_EMBEDDING_API_KEY=ollama

VAULT_PATH=./data/vault.enc
VAULT_KEYCHAIN_SERVICE=com.myassistant.vault
VAULT_KEYCHAIN_ACCOUNT=default
VAULT_AUTO_LOCK_MINUTES=15
ASSETS_ENABLED=true
ASSETS_PATH=./data/assets.json
ASSET_EXEC_ENABLED=false
ASSET_EXEC_TIMEOUT_SECONDS=60
ASSET_EXEC_MAX_OUTPUT_CHARS=12000
ASSET_EXEC_AUDIT_PATH=./data/asset-exec-audit.log
# Optional master key overrides (default: macOS Keychain)
# VAULT_MASTER_KEY=            # base64-encoded 32-byte key, dev/CI only
# VAULT_PASSPHRASE=            # derives the key with Argon2id (salt stored beside the vault)

DAEMON_ENABLED=false
DAEMON_SOCKET_PATH=./data/assistant.sock
DAEMON_LOCAL_SESSION_DIR=./data/local-sessions
DAEMON_LOCAL_SESSION_IDLE_MINUTES=120

DWS_ENABLED=false
DWS_GATEWAY_URL=http://127.0.0.1:8787
DWS_GATEWAY_TOKEN=
DWS_HISTORY_GROUPS=
DWS_HISTORY_INTERVAL_MINUTES=60
DWS_HISTORY_OVERLAP_MINUTES=10
DWS_HISTORY_BACKFILL_DAYS=30
DWS_REQUEST_TIMEOUT_SECONDS=120
DWS_PAGE_SIZE=100
DWS_MAX_ITEMS_PER_SYNC=5000

REVIEW_ENABLED=false
REVIEW_HOST=127.0.0.1
REVIEW_PORT=8788
REVIEW_TOKEN=
REVIEW_TOP_K=8
REVIEW_RECENT_MESSAGES=15
REVIEW_SUMMARY_PATH=./data/conversation-summaries.json
REVIEW_MAX_CONTENT_CHARS=8000
REVIEW_TIMEOUT_SECONDS=90
REVIEW_AUTO_REPLY=false
REVIEW_AUTO_REPLY_DMS=
REVIEW_REPLY_DEBOUNCE_SECONDS=8
REVIEW_REPLY_DEBOUNCE_MAX_SECONDS=30
REVIEW_BLOCK_CONTINUATION_SECONDS=180
REVIEW_BLOCK_PATH=./data/reply-blocks.json
BLACKBOARD_ENABLED=false
BLACKBOARD_PATH=./data/blackboard.json
BLACKBOARD_GROUP_ID=
BLACKBOARD_MAX_COMPLETED=5

TASKS_ENABLED=true
TASKS_BACKEND=local
TASKS_PATH=./data/tasks.json
TASKS_SESSION_DIR=./data/task-sessions
TASKS_CONCURRENCY=2
TASKS_TIMEOUT_MINUTES=30
TASKS_MAX_RECORDS=500
# TASKS_BACKEND=http-a2a
# TASKS_HTTP_URL=http://127.0.0.1:8787/tasks
# TASKS_PI_RPC_CLI=/path/to/pi/dist/bundle/cli.js
