{
  "name": "myassistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A personal assistant built on pi, with RAG memory, a local vault, DingTalk, and task delegation.",
  "engines": {
    "node": ">=22.19"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx apps/assistant/src/index.ts",
    "daemon": "tsx apps/assistant/src/index.ts --daemon",
    "daemon:install": "tsx apps/assistant/src/launchd.ts install",
    "daemon:uninstall": "tsx apps/assistant/src/launchd.ts uninstall",
    "daemon:status": "tsx apps/assistant/src/launchd.ts status",
    "dingtalk:check": "tsx apps/assistant/src/dingtalk-check.ts",
    "dingtalk:dws-check": "tsx apps/assistant/src/dingtalk-dws-check.ts",
    "dingtalk:history": "tsx apps/assistant/src/dingtalk-history.ts",
    "dingtalk:sync": "tsx apps/assistant/src/dingtalk-sync.ts",
    "dws-watch": "tsx apps/dws-watch/src/index.ts",
    "dws-watch:start": "node dist/dws-watch.js",
    "model:check": "tsx apps/assistant/src/model-check.ts",
    "gateway": "tsx apps/dws-gateway/src/index.ts",
    "gateway:start": "node dist/dws-gateway.js",
    "login": "pi",
    "assistant": "tsx apps/assistant/src/client.ts",
    "vault": "tsx apps/assistant/src/cli.ts",
    "assets": "tsx apps/assistant/src/asset-cli.ts",
    "build": "tsup",
    "start": "node dist/assistant.js",
    "start:daemon": "node dist/assistant.js --daemon",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "tsx scripts/smoke-daemon.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
